    {
      "id": 1,
      "type": "timeseries",
      "title": "Sessions per hour",
      "description": "meru.sessions: new sessions each hour, by source (cli, tui, job or desktop).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "1h",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "interval": "1h",
          "expr": "sum by (meru_source) (increase(meru_sessions_total{job=\"merud\"}[$__interval]))",
          "legendFormat": "{{meru_source}}"
        }
      ]
    },
