{
  "uid": "meru-usage",
  "title": "Meru usage",
  "description": "merud: sessions, questions, tokens, active time, files read and tool calls, one bar per day.",
  "tags": [
    "meru"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Sessions per day",
      "description": "meru.sessions: new sessions each day, by source (cli, tui, job or desktop).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "1d",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "interval": "1d",
          "expr": "sum by (meru_source) (increase(meru_sessions_total{job=\"merud\"}[$__interval]))",
          "legendFormat": "{{meru_source}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Questions per day",
      "description": "meru.turn.duration count: answered questions each day, by route.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "1d",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "interval": "1d",
          "expr": "sum by (meru_route) (increase(meru_turn_duration_seconds_count{job=\"merud\", meru_outcome=\"ok\"}[$__interval]))",
          "legendFormat": "{{meru_route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tokens per day",
      "description": "meru.turn.tokens: the main model's input and output tokens each day, summed over answered turns.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "1d",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "interval": "1d",
          "expr": "sum by (gen_ai_token_type) (increase(meru_turn_tokens_total{job=\"merud\"}[$__interval]))",
          "legendFormat": "{{gen_ai_token_type}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Active time per day",
      "description": "meru.turn.duration sum: time merud spent answering each day, question to done, by route.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "1d",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "interval": "1d",
          "expr": "sum by (meru_route) (increase(meru_turn_duration_seconds_sum{job=\"merud\", meru_outcome=\"ok\"}[$__interval]))",
          "legendFormat": "{{meru_route}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Files per question",
      "description": "meru.turn.docs: the average number of distinct files whose excerpts went into an answered question's prompt, each day, by route.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "1d",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "interval": "1d",
          "expr": "sum by (meru_route) (increase(meru_turn_docs_sum{job=\"merud\"}[$__interval])) / sum by (meru_route) (increase(meru_turn_docs_count{job=\"merud\"}[$__interval]))",
          "legendFormat": "{{meru_route}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tool calls per day",
      "description": "meru.tool.calls: tool calls each day, by outcome.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "1d",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "interval": "1d",
          "expr": "sum by (meru_outcome) (increase(meru_tool_calls_total{job=\"merud\"}[$__interval]))",
          "legendFormat": "{{meru_outcome}}"
        }
      ]
    }
  ]
}
